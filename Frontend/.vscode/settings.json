{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.jsx": "${capture}.styles.js",
    "*.js": "${capture}.styles.js",
    "package.json": "package-lock.json, eas.json, app.json"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.expo": true,
    "**/dist": true
  }
}
